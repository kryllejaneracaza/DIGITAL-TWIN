    {
        "id": "e1",
        "type": "inject",
        "z": "dd001c7bf6cb4b98",
        "name": "1. Init Database",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "x": 160,
        "y": 180,
        "wires": [
            [
                "e2"
            ]
        ]
    },
    {
        "id": "e2",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Build Schema",
        "func": "msg.topic = `\nCREATE TABLE IF NOT EXISTS Building (building_ID INTEGER PRIMARY KEY AUTOINCREMENT, building_name TEXT NOT NULL, location TEXT);\nCREATE TABLE IF NOT EXISTS Room (room_ID INTEGER PRIMARY KEY AUTOINCREMENT, building_ID INTEGER NOT NULL, room_name TEXT NOT NULL, floor_plan_data TEXT, plan_width REAL, plan_height REAL);\nCREATE TABLE IF NOT EXISTS Controllers (controller_ID INTEGER PRIMARY KEY AUTOINCREMENT, room_ID INTEGER NOT NULL, controller_name TEXT, mac_address TEXT, ip_address TEXT, status TEXT, wifi TEXT, last_seen TEXT);\nCREATE TABLE IF NOT EXISTS Sensors (sensor_ID INTEGER PRIMARY KEY AUTOINCREMENT, controller_ID INTEGER NOT NULL, sensor_type TEXT, gpio_pin INTEGER, pos_x REAL, pos_y REAL);\nCREATE TABLE IF NOT EXISTS Sensor_Readings (reading_ID INTEGER PRIMARY KEY AUTOINCREMENT, sensor_ID INTEGER NOT NULL, temperature REAL, humidity REAL, occupied INTEGER, recorded_at TEXT);\nCREATE TABLE IF NOT EXISTS Appliances (appliance_ID INTEGER PRIMARY KEY AUTOINCREMENT, room_ID INTEGER NOT NULL, controller_ID INTEGER, appliance_name TEXT, appliance_type TEXT, gpio_pin INTEGER, pos_x REAL, pos_y REAL);\nCREATE TABLE IF NOT EXISTS Appliance_Status (status_ID INTEGER PRIMARY KEY AUTOINCREMENT, appliance_ID INTEGER NOT NULL, reported_state TEXT, desired_state TEXT, in_sync INTEGER, updated_at TEXT);\nCREATE TABLE IF NOT EXISTS IR_Command_Codes (code_ID INTEGER PRIMARY KEY AUTOINCREMENT, appliance_ID INTEGER, action TEXT, protocol TEXT, raw_code TEXT);\nCREATE TABLE IF NOT EXISTS Automation_Rules (rules_ID INTEGER PRIMARY KEY AUTOINCREMENT, room_ID INTEGER NOT NULL, appliance_ID INTEGER, trigger_type TEXT, threshold REAL, duration_minutes INTEGER, action TEXT, target_value REAL, is_active INTEGER DEFAULT 1);\nCREATE TABLE IF NOT EXISTS Users (user_ID INTEGER PRIMARY KEY AUTOINCREMENT, user_name TEXT, user_email TEXT UNIQUE, password_hash TEXT, role TEXT DEFAULT 'user', created_at TEXT);\nCREATE TABLE IF NOT EXISTS User_Room_Access (user_ID INTEGER, room_ID INTEGER, PRIMARY KEY(user_ID, room_ID));\nCREATE TABLE IF NOT EXISTS Detection (detection_ID INTEGER PRIMARY KEY AUTOINCREMENT, reading_ID INTEGER, room_ID INTEGER, detection_type TEXT, detection_result TEXT, detected_at TEXT);\nCREATE TABLE IF NOT EXISTS Commands (command_ID INTEGER PRIMARY KEY AUTOINCREMENT, appliance_ID INTEGER NOT NULL, user_ID INTEGER, rule_ID INTEGER, source TEXT, action TEXT, status TEXT, sent_at TEXT, confirmed_at TEXT, response_ms INTEGER);\nCREATE TABLE IF NOT EXISTS Log_History (log_history_ID INTEGER PRIMARY KEY AUTOINCREMENT, user_ID INTEGER, log_time TEXT, log_status TEXT, raw_code TEXT);\nCREATE TABLE IF NOT EXISTS Notifications (notification_ID INTEGER PRIMARY KEY AUTOINCREMENT, user_ID INTEGER, room_ID INTEGER, detection_ID INTEGER, command_ID INTEGER, notification_message TEXT, notification_is_read INTEGER DEFAULT 0, notification_sent_at TEXT, delivered_at TEXT);\n`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 180,
        "wires": [
            [
                "f03dce44111192f5"
            ]
        ]
    },
    {
        "id": "e4",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Check Empty",
        "func": "msg.topic = \"SELECT COUNT(*) as c FROM Building\";\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 180,
        "wires": [
            [
                "f5070bdad12b6f55"
            ]
        ]
    },
    {
        "id": "e6",
        "type": "switch",
        "z": "dd001c7bf6cb4b98",
        "name": "Is Empty?",
        "property": "payload[0].c",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "0",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 960,
        "y": 180,
        "wires": [
            [
                "c973f159fbac9d13"
            ]
        ]
    },
    {
        "id": "e7",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Seed Data",
        "func": "const sql = `\nINSERT INTO Building (building_name, location) VALUES ('EcoBuild HQ', 'Downtown');\nINSERT INTO Room (building_ID, room_name, floor_plan_data, plan_width, plan_height) VALUES (1, 'Living Room', '{}', 800, 600), (1, 'Bedroom', '{}', 600, 400), (1, 'Kitchen', '{}', 700, 500);\nINSERT INTO Controllers (room_ID, controller_name, mac_address, ip_address, status, wifi, last_seen) VALUES (1, 'Ctrl-01', 'AA:BB:CC:DD:EE:01', '192.168.1.10', 'online', 'WPA2', '2026-11-08T10:00:00Z'), (2, 'Ctrl-02', 'AA:BB:CC:DD:EE:02', '192.168.1.11', 'online', 'WPA2', '2026-11-08T10:00:00Z'), (3, 'Ctrl-03', 'AA:BB:CC:DD:EE:03', '192.168.1.12', 'online', 'WPA2', '2026-11-08T10:00:00Z');\nINSERT INTO Sensors (controller_ID, sensor_type, gpio_pin, pos_x, pos_y) VALUES (1, 'DHT22', 4, 100, 100), (2, 'DHT22', 4, 50, 50), (3, 'PIR', 5, 300, 200);\nINSERT INTO Appliances (room_ID, controller_ID, appliance_name, appliance_type, gpio_pin, pos_x, pos_y) VALUES (1, 1, 'Living Light', 'light', 12, 200, 150), (1, 1, 'TV', 'tv', 13, 400, 300), (2, 2, 'Bed Light', 'light', 12, 150, 100), (3, 3, 'Fridge', 'appliance', 14, 350, 250);\nINSERT INTO Appliance_Status (appliance_ID, reported_state, desired_state, in_sync, updated_at) VALUES (1, 'OFF', 'OFF', 1, '2026-11-08T10:00:00Z'), (2, 'OFF', 'OFF', 1, '2026-11-08T10:00:00Z'), (3, 'OFF', 'OFF', 1, '2026-11-08T10:00:00Z'), (4, 'ON', 'ON', 1, '2026-11-08T10:00:00Z');\nINSERT INTO Users (user_name, user_email, password_hash, role, created_at) VALUES ('admin', 'admin@ecobuild.io', 'admin123', 'admin', '2026-11-08T10:00:00Z');\nINSERT INTO Automation_Rules (room_ID, appliance_ID, trigger_type, threshold, duration_minutes, action, target_value, is_active) VALUES (1, 1, 'motion', 1, 5, 'turn_on', 1, 1);\n`;\nmsg.topic = sql;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1230,
        "y": 180,
        "wires": [
            []
        ]
    },
