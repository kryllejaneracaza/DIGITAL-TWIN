    {
        "id": "d2",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Query",
        "func": "msg.topic = 'SELECT a.*, s.reported_state FROM Appliances a LEFT JOIN Appliance_Status s ON s.appliance_ID = a.appliance_ID';\nreturn msg;",
