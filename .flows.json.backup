    {
        "id": "eb0012",
        "type": "http in",
        "z": "eb_tab",
        "name": "GET /api/health",
        "url": "/api/health",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 150,
        "y": 270,
        "wires": [
            [
                "eb0013"
            ]
        ]
    },
    {
        "id": "eb0013",
        "type": "function",
        "z": "eb_tab",
        "name": "Health",
        "func": "const Q=v=>(v===null||v===undefined||v==='')?'NULL':\"'\"+String(v).replace(/'/g,\"''\")+\"'\";\nconst N=v=>(v===null||v===undefined||v===''||!Number.isFinite(Number(v)))?'NULL':Number(v);\nconst I=v=>(v!==null&&v!==undefined&&v!==''&&Number.isInteger(Number(v)))?Number(v):null;\nconst iso=s=>s?String(s).replace(' ','T')+'Z':null;\nconst ago=s=>{if(!s)return null;const d=(Date.now()-new Date(iso(s)).getTime())/1000;if(d<60)return 'just now';if(d<3600)return Math.floor(d/60)+'m ago';if(d<86400)return Math.floor(d/3600)+'h ago';return Math.floor(d/86400)+'d ago';};\nconst fail=(c,e)=>{msg.statusCode=c;msg.payload={error:e};return [null,msg];};\nconst sql=q=>{msg.topic=q;msg.payload=[];};\nconst auth=()=>{if(env.get('ECOBUILD_AUTH')==='off'){msg.user={users_ID:1,users_name:'dev',role:'administrator'};return null;}const t=((msg.req.headers.authorization)||'').replace(/^Bearer\\s+/i,'');const s=(global.get('sessions')||{})[t];if(!s||s.exp<Date.now())return fail(401,'Unauthorized');msg.user=s;msg.token=t;return null;};\nconst deviceAuth=()=>((msg.req.headers['x-device-key']||'')!==(env.get('DEVICE_KEY')||'ecobuild-device-key'))?fail(401,'Invalid device key'):null;\nconst NOTIF=(room,det,cmd,lvl,text)=>`INSERT INTO Notifications(user_ID,room_ID,detection_ID,command_ID,notification_message,notification_level,notification_sent_at,delivered_at) SELECT users_ID,${room},${det},${cmd},${Q(text)},${Q(lvl)},datetime('now'),datetime('now') FROM Users;`;\nconst LATEST=(col,room,nn)=>`(SELECT sr.${col} FROM Sensor_Readings sr JOIN Sensors s ON s.sensor_ID=sr.sensor_ID JOIN Controllers c ON c.controllers_ID=s.controller_ID WHERE c.room_ID=${room} AND sr.${nn||col} IS NOT NULL ORDER BY sr.recorded_at DESC,sr.readings_ID DESC LIMIT 1)`;\nconst floorOf=s=>{try{return JSON.parse(s).floor||null}catch(e){return null}};\nmsg.statusCode=200;msg.payload={status:'ok',time:new Date().toISOString(),simulation:global.get('simulation')!==false};return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 270,
        "wires": [
            [
                "eb_resp"
            ]
        ]
    },
    {
