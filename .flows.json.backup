    {
        "id": "eco0155",
        "type": "comment",
        "z": "ecotab7",
        "name": "ESP32 / hardware endpoints. Send header  x-device-key: <DEVICE_KEY from config.js>.",
        "info": "ESP32 / hardware endpoints. Send header  x-device-key: <DEVICE_KEY from config.js>.\nThe blue inject node at the bottom is a DEMO SIMULATOR: it is disabled by default. Enable it (and Deploy) to generate fake sensor data every 30 seconds.",
        "x": 300,
        "y": 50,
        "wires": []
    },
    {
        "id": "eco0156",
        "type": "http in",
        "z": "ecotab7",
        "name": "POST /api/device/heartbeat",
        "url": "/api/device/heartbeat",
        "method": "post",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 190,
        "y": 100,
        "wires": [
            [
                "eco0157"
            ]
        ]
    },
    {
        "id": "eco0157",
        "type": "function",
        "z": "ecotab7",
        "name": "device.heartbeat",
        "func": "const eco = global.get('eco');\n\n// Use Promise to ensure the response object is passed back\neco.handle('device.heartbeat', msg)\n  .then((result) => {\n    // If result is already a full msg object, use it. Otherwise, wrap it.\n    let outMsg = (result && result.payload !== undefined) ? result : { payload: result };\n    \n    // ✅ CRITICAL FIX: Attach the original req and res objects\n    outMsg.req = msg.req;\n    outMsg.res = msg.res;\n    \n    node.send(outMsg);\n  })\n  .catch((err) => {\n    // Handle errors gracefully so ESP32 doesn't just timeout\n    node.error(\"Error handling heartbeat\", msg);\n    msg.statusCode = 500;\n    msg.payload = { error: err.message };\n    node.send(msg);\n  });\n\nreturn null; // Tell Node-RED we are handling the output asynchronously",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 100,
        "wires": [
            [
                "eco0158"
            ]
        ]
    },
    {
        "id": "eco0158",
        "type": "http response",
        "z": "ecotab7",
        "name": "",
        "statusCode": "",
        "headers": {
            "Content-Type": "application/json"
        },
        "x": 700,
        "y": 100,
        "wires": []
    },
