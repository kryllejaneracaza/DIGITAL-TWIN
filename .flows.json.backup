    {
        "id": "s2",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Sensors",
        "func": "msg.topic = 'SELECT sensor_ID FROM Sensors';\nreturn msg;",
        "outputs": 1,
        "x": 320,
        "y": 600,
        "wires": [
            [
                "1b24d66da0db5ef4"
            ]
        ]
    },
    {
        "id": "s4",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Readings",
        "func": "const sensors = msg.payload || [];\nif (!sensors.length) return null;\nconst now = new Date().toISOString();\nconst values = sensors.map(s => {\n  const temp = (20 + Math.random() * 6).toFixed(1);\n  const occ = Math.random() > 0.7 ? 1 : 0;\n  return `(${s.sensor_ID}, ${temp}, 50, ${occ}, '${now}')`;\n}).join(',');\nmsg.topic = `INSERT INTO Sensor_Readings (sensor_ID, temperature, humidity, occupied, recorded_at) VALUES ${values}`;\nreturn msg;",
        "outputs": 1,
        "x": 620,
        "y": 600,
        "wires": [
            [
                "0983862eaf269854"
            ]
        ]
    },
    {
        "id": "s6",
        "type": "debug",
        "z": "dd001c7bf6cb4b98",
        "name": "Twin Synced",
        "active": true,
        "tosidebar": true,
        "x": 920,
        "y": 600,
        "wires": []
    },
    {
        "id": "a1",
        "type": "http in",
        "z": "dd001c7bf6cb4b98",
        "name": "GET Rooms",
        "url": "/api/rooms",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 300,
        "wires": [
            [
                "a2"
            ]
        ]
    },
    {
        "id": "a2",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Query",
        "func": "msg.topic = 'SELECT * FROM Room';\nreturn msg;",
        "outputs": 1,
        "x": 300,
        "y": 300,
        "wires": [
            [
                "9ddffe9225e060b0"
            ]
        ]
    },
    {
        "id": "a4",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Query Appliances",
        "func": "msg.rooms = msg.payload;\nmsg.topic = 'SELECT * FROM Appliances';\nreturn msg;",
        "outputs": 1,
        "x": 610,
        "y": 300,
        "wires": [
            [
                "b773af9f5372e2cb"
            ]
        ]
    },
    {
        "id": "a6",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Merge",
        "func": "const rooms = msg.rooms || [];\nconst appliances = msg.payload || [];\nmsg.payload = rooms.map(r => ({ ...r, appliances: appliances.filter(a => a.room_ID === r.room_ID) }));\nmsg.statusCode = 200;\nmsg.headers = { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' };\nreturn msg;",
        "outputs": 1,
        "x": 930,
        "y": 300,
        "wires": [
            [
                "a7"
            ]
        ]
    },
    {
        "id": "a7",
        "type": "http response",
        "z": "dd001c7bf6cb4b98",
        "name": "Respond",
        "x": 1080,
        "y": 300,
        "wires": []
    },
    {
        "id": "c1",
        "type": "http in",
        "z": "dd001c7bf6cb4b98",
        "name": "POST Command",
        "url": "/api/command",
        "method": "post",
        "x": 150,
        "y": 400,
        "wires": [
            [
                "c2"
            ]
        ]
    },
    {
        "id": "c2",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Prepare",
        "func": "const { appliance_ID, action } = msg.payload;\nif (!appliance_ID || !action) {\n  msg.statusCode = 400;\n  msg.payload = { error: 'appliance_ID and action required' };\n  return [null, msg];\n}\nconst now = new Date().toISOString();\nmsg.cmd = { appliance_ID: Number(appliance_ID), action };\nmsg.topic = `INSERT INTO Commands (appliance_ID, source, action, status, sent_at) VALUES (${Number(appliance_ID)}, 'api', '${action}', 'pending', '${now}')`;\nreturn [msg, null];",
        "outputs": 2,
        "x": 320,
        "y": 400,
        "wires": [
            [
                "ab4a9557f66c9d3e"
            ],
            [
                "cerr"
            ]
        ]
    },
    {
        "id": "c4",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Update State",
        "func": "const { appliance_ID, action } = msg.cmd;\nconst state = /on/i.test(action) ? 'ON' : 'OFF';\nmsg.state = state;\nmsg.topic = `UPDATE Appliance_Status SET reported_state = '${state}', desired_state = '${state}', in_sync = 1, updated_at = '${new Date().toISOString()}' WHERE appliance_ID = ${appliance_ID}`;\nreturn msg;",
        "outputs": 1,
        "x": 620,
        "y": 400,
        "wires": [
            [
                "0a1e9fb9e7259ee4"
            ]
        ]
    },
    {
        "id": "c6",
        "type": "function",
        "z": "dd001c7bf6cb4b98",
        "name": "Respond",
        "func": "msg.statusCode = 200;\nmsg.headers = { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' };\nmsg.payload = { message: 'Command executed', appliance_ID: msg.cmd.appliance_ID, new_state: msg.state };\nreturn msg;",
        "outputs": 1,
        "x": 930,
        "y": 400,
        "wires": [
            [
                "c7"
            ]
        ]
    },
    {
        "id": "c7",
        "type": "http response",
        "z": "dd001c7bf6cb4b98",
        "name": "Respond",
        "x": 1080,
        "y": 400,
        "wires": []
    },
    {
        "id": "cerr",
        "type": "http response",
        "z": "dd001c7bf6cb4b98",
        "name": "Err",
        "statusCode": "400",
        "x": 470,
        "y": 450,
        "wires": []
    },
    {
        "id": "d1",
        "type": "http in",
        "z": "dd001c7bf6cb4b98",
        "name": "GET Appliances",
        "url": "/api/appliances",
