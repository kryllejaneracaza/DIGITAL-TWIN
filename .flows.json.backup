')} occupied,${LATEST('readings_ID','r.room_ID','temperature')} temp_reading_id,${LATEST('readings_ID','r.room_ID','occupied')} occ_reading_id,(SELECT CAST((julianday('now')-julianday(MAX(sr.recorded_at)))*1440 AS INTEGER) FROM Sensor_Readings sr JOIN Sensors s ON s.sensor_ID=sr.sensor_ID JOIN Controllers c ON c.controllers_ID=s.controller_ID WHERE c.room_ID=r.room_ID AND sr.occupied=1) mins_since_occupied FROM Room r`);return msg;",
