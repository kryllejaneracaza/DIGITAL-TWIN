    {
        "id": "eco0024",
        "type": "function",
        "z": "ecotab1",
        "name": "JSON 500",
        "func": "const res = msg.res && msg.res._res;\n\nif (!res || res.headersSent) {\n    node.warn(\"Suppressed error after response was sent\");\n    return null;\n}\n\nconst detail = msg.error\n    ? (msg.error.message + \" | source: \" + (msg.error.source && msg.error.source.name))\n    : \"unknown\";\n\nnode.warn(\"REAL ERROR: \" + detail);\n\nmsg.statusCode = 500;\nmsg.payload = { success: false, message: \"Internal server error\", detail: detail };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
