        "type": "function",
        "z": "ecotab7",
        "name": "device.readings",
        "func": "const eco = global.get('eco');\nconst result = eco.handle('device.readings', msg);\n\nif (result instanceof Promise) {\n    result.then((res) => {\n        let outMsg = (res && res.payload !== undefined) ? res : { payload: res };\n        outMsg.req = msg.req; outMsg.res = msg.res;\n        node.send(outMsg);\n    }).catch((err) => {\n        msg.statusCode = 500; msg.payload = { error: err.message };\n        node.send(msg);\n    });\n    return null;\n} else {\n    let outMsg = (result && result.payload !== undefined) ? result : { payload: result };\n    outMsg.req = msg.req; outMsg.res = msg.res;\n    return outMsg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
