    {
        "id": "e4e93fd3c9375b34",
        "type": "sqlite",
        "z": "ecotab1",
        "d": true,
        "mydb": "73e7995ec6aa1a35",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "",
        "x": 550,
        "y": 200,
