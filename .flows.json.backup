    {
        "id": "a91586949c7887c4",
        "type": "function",
        "z": "eb_tab",
        "name": "Validate",
        "func": "const bcrypt = global.get('bcrypt'); // Ensure bcrypt is in your settings.js functionGlobalContext\nconst user = msg.payload[0]; // The result from SQLite\nconst password = msg.req.body.password; // The password from Flutter\n\nif (!user) {\n    msg.statusCode = 401;\n    msg.payload = { success: false, message: \"Invalid email or password\" };\n    return msg;\n}\n\n// Verify the password hash\nbcrypt.compare(password, user.users_password_hash).then((match) => {\n    if (match) {\n        // Generate JWT Token\n        const jwt = global.get('jsonwebtoken');\n        const token = jwt.sign({ id: user.users_ID, role: user.role }, 'YOUR_SECRET_KEY', { expiresIn: '1d' });\n        \n        msg.statusCode = 200;\n        msg.payload = {\n            success: true,\n            token: token,\n            user: {\n                id: user.users_ID,\n                name: user.users_name,\n                email: user.users_email,\n                role: user.role\n            }\n        };\n    } else {\n        msg.statusCode = 401;\n        msg.payload = { success: false, message: \"Invalid email or password\" };\n    }\n    node.send(msg);\n}).catch((err) => {\n    msg.statusCode = 500;\n    msg.payload = { success: false, message: err.message };\n    node.send(msg);\n});\nreturn null;",
