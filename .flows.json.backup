    {
        "id": "eb_errfn",
        "type": "function",
        "z": "eb_tab",
        "name": "Error -> HTTP",
        "func": "if(!msg.res)return null;\nconst m=(msg.error&&msg.error.message)||'Internal error';\nconst uq=/UNIQUE/i.test(m),nn=/NOT NULL|constraint/i.test(m);\nmsg.statusCode=uq?409:(nn?400:500);\nmsg.payload={error:uq?'Already exists':(nn?'Invalid or missing data':'Internal server error'),detail:m};\nreturn msg;",
