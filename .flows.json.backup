    {
        "id": "61c89b4c53f6a0b2",
        "type": "function",
        "z": "ecotab1",
        "d": true,
        "name": "validate",
        "func": "const rows = msg.payload;\n\nconst invalid = () => {\n    msg.statusCode = 401;\n    msg.payload = { error: \"Invalid email or password\" };\n    return msg;\n};\n\nasync function run() {\n    if (!Array.isArray(rows) || rows.length === 0) return invalid();\n\n    const u = rows[0];\n    const stored = u.users_password_hash;\n    if (!stored || !msg.loginPassword) return invalid();\n\n    let ok;\n    if (/^\\$2[aby]\\$/.test(stored)) {\n        // existing accounts: bcrypt hash\n        const bcrypt = require(\"bcryptjs\");\n        ok = await bcrypt.compare(msg.loginPassword, stored);\n    } else {\n        // plain-text password\n        ok = (stored === msg.loginPassword);\n    }\n    if (!ok) return invalid();\n\n    const token = crypto.randomBytes(32).toString('hex');\n    const user = { users_ID: u.users_ID, users_name: u.users_name, role: u.role };\n\n    const sessions = global.get('sessions') || {};\n    sessions[token] = Object.assign({}, user, { exp: Date.now() + 7 * 24 * 3600 * 1000 });\n    global.set('sessions', sessions);\n\n    msg.statusCode = 200;\n    msg.payload = { token: token, user: user };\n    return msg;\n}\n\nreturn run().catch(err => {\n    node.warn(\"login failed: \" + err.message);\n    msg.statusCode = 500;\n    msg.payload = { error: \"Login failed\" };\n    return msg;\n});",
        "outputs": 1,
        "timeout": 0,
        "noerr": 2,
        "initialize": "",
        "finalize": "",
