    {
        "id": "855da4a49b6e0875",
        "type": "debug",
        "z": "eb_tab",
        "name": "debug 1",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "complete msg object",
