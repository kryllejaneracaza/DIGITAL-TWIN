        ]
    },
    {
        "id": "eb0173",
        "type": "function",
        "z": "eb_tab",
        "name": "Evaluate Alerts + Rules",
        "func": "const Q=v=>(v===null||v===undefined||v==='')?'NULL':\"'\"+String(v).replace(/'/g,\"''\")+\"'\";\nconst N=v=>(v===null||v===undefined||v===''||!Number.isFinite(Number(v)))?'NULL':Number(v);\nconst I=v=>(v!==null&&v!==undefined&&v!==''&&Number.isInteger(Number(v)))?Number(v):null;\nconst iso=s=>s?String(s).replace(' ','T')+'Z':null;\nconst ago=s=>{if(!s)return null;const d=(Date.now()-new Date(iso(s)).getTime())/1000;if(d<60)return 'just now';if(d<3600)return Math.floor(d/60)+'m ago';if(d<86400)return Math.floor(d/3600)+'h ago';return Math.floor(d/86400)+'d ago';};\nconst fail=(c,e)=>{msg.statusCode=c;msg.payload={error:e};return [null,msg];};\nconst sql=q=>{msg.topic=q;msg.payload=[];};\nconst auth=()=>{if(env.get('ECOBUILD_AUTH')==='off'){msg.user={users_ID:1,users_name:'dev',role:'administrator'};return null;}const t=((msg.req.headers.authorization)||'').replace(/^Bearer\\s+/i,'');const s=(global.get('sessions')||{})[t];if(!s||s.exp<Date.now())return fail(401,'Unauthorized');msg.user=s;msg.token=t;return null;};\nconst deviceAuth=()=>((msg.req.headers['x-device-key']||'')!==(env.get('DEVICE_KEY')||'ecobuild-device-key'))?fail(401,'Invalid device key'):null;\nconst NOTIF=(room,det,cmd,lvl,text)=>`INSERT INTO Notifications(user_ID,room_ID,detection_ID,command_ID,notification_message,notification_level,notification_sent_at,delivered_at) SELECT users_ID,${room},${det},${cmd},${Q(text)},${Q(lvl)},datetime('now'),datetime('now') FROM Users;`;\nconst LATEST=(col,room,nn)=>`(SELECT sr.${col} FROM Sensor_Readings sr JOIN Sensors s ON s.sensor_ID=sr.sensor_ID JOIN Controllers c ON c.controllers_ID=s.controller_ID WHERE c.room_ID=${room} AND sr.${nn||col} IS NOT NULL ORDER BY sr.recorded_at DESC,sr.readings_ID DESC LIMIT 1)`;\nconst floorOf=s=>{try{return JSON.parse(s).floor||null}catch(e){return null}};\nconst HOT=30;\nconst rooms=msg.rooms||[],rules=msg.payload||[];\nconst es=flow.get('engineState')||{hot:{},occ:{}};\nconst sim=global.get('simulation')!==false;\nconst out=[],by={},touched={};\nrooms.forEach(r=>{by[r.room_ID]=r;\n if(r.temperature!==null){const hot=!!es.hot[r.room_ID];\n  if(r.temperature>=HOT&&!hot){es.hot[r.room_ID]=true;\n   out.push(`INSERT INTO Detection(reading_ID,room_ID,detection_type,detection_result) VALUES(${N(r.temp_reading_id)},${r.room_ID},'high_temperature',${Q(r.temperature+'°C')});`,\n   NOTIF(r.room_ID,'(SELECT MAX(detection_ID) FROM Detection)','NULL','warning',`High temperature: ${r.room_name} is ${r.temperature}°C`));}\n  else if(r.temperature<HOT-1&&hot)es.hot[r.room_ID]=false;}\n if(r.occupied!==null){const prev=es.occ[r.room_ID];\n  if(prev!==undefined&&prev!==r.occupied){\n   out.push(`INSERT INTO Detection(reading_ID,room_ID,detection_type,detection_result) VALUES(${N(r.occ_reading_id)},${r.room_ID},'occupancy',${Q(r.occupied?'occupied':'vacant')});`,\n   NOTIF(r.room_ID,'(SELECT MAX(detection_ID) FROM Detection)','NULL','info',`${r.room_name} is now ${r.occupied?'occupied':'vacant'}`));}\n  es.occ[r.room_ID]=r.occupied;}\n});\nrules.forEach(ru=>{const r=by[ru.room_ID];if(!r||touched[ru.appliances_ID])return;\n let hit=false;\n switch(ru.trigger_type){\n  case 'temperature_above':hit=r.temperature!==null&&r.temperature>ru.threshold;break;\n  case 'temperature_below':hit=r.temperature!==null&&r.temperature<ru.threshold;break;\n  case 'humidity_above':hit=r.humidity!==null&&r.humidity>ru.threshold;break;\n  case 'vacant_for':hit=r.occupied===0&&(r.mins_since_occupied===null||r.mins_since_occupied>=ru.duration_minutes);break;}\n if(!hit||ru.desired_state===ru.action)return;\n touched[ru.appliances_ID]=true;\n const ms=Math.floor(300+Math.random()*900);\n out.push(`INSERT INTO Commands(appliances_ID,user_ID,rule_ID,source,action,status,sent_at,confirmed_at,response_ms) VALUES(${ru.appliances_ID},NULL,${ru.rules_ID},'automation',${Q(ru.action)},${sim?\"'confirmed'\":\"'sent'\"},datetime('now'),${sim?\"datetime('now')\":'NULL'},${sim?ms:'NULL'});`);\n out.push(sim?`UPDATE Appliance_States SET desired_state=${Q(ru.action)},reported_state=${Q(ru.action)},in_sync=1,updated_at=datetime('now') WHERE appliances_ID=${ru.appliances_ID};`\n  :`UPDATE Appliance_States SET desired_state=${Q(ru.action)},in_sync=0,updated_at=datetime('now') WHERE appliances_ID=${ru.appliances_ID};`);\n out.push(NOTIF(ru.room_ID,'NULL','(SELECT MAX(command_ID) FROM Commands)','info',`Automation executed: ${ru.appliances_name} turned ${ru.action} in ${r.room_name}`));\n});\nflow.set('engineState',es);\nif(!out.length)return null;\nmsg.topic=out.join('\\n');msg.payload=[];return msg;",
