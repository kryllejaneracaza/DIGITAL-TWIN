    {
        "id": "88634caa847cf7e1",
        "type": "function",
        "z": "eb_tab",
        "name": "Format Response",
        "func": "if (msg.passwordVerified === true) {\n    msg.payload = {\n        success: true,\n        message: \"Login successful\",\n        token: msg.token || \"FAKE_TOKEN_123\",\n        user: msg.user\n    };\n    msg.statusCode = 200;\n} else {\n    msg.payload = {\n        success: false,\n        message: \"Invalid email or password\"\n    };\n    msg.statusCode = 401;\n}\n\n// Ensure headers are set\nmsg.headers = { \"Content-Type\": \"application/json\" };\n\n// MUST RETURN msg\nreturn msg;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
