    {
        "id": "eb0001",
        "type": "comment",
        "z": "eb_tab",
        "name": "1. INIT + SEED  (runs once on deploy; login = leachim@gmail.com / admin123)",
        "info": "",
        "x": 180,
        "y": 95,
        "wires": []
    },
    {
        "id": "eb0002",
        "type": "inject",
        "z": "eb_tab",
        "name": "1. Init Database",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 155,
        "wires": [
            [
                "eb0003"
            ]
        ]
    },
    {
        "id": "eb0003",
        "type": "function",
        "z": "eb_tab",
        "name": "Build Schema",
        "func": "msg.topic=\"\\nCREATE TABLE IF NOT EXISTS Building(building_ID INTEGER PRIMARY KEY AUTOINCREMENT,building_name TEXT NOT NULL,location TEXT);\\nCREATE TABLE IF NOT EXISTS Room(room_ID INTEGER PRIMARY KEY AUTOINCREMENT,building_ID INTEGER NOT NULL REFERENCES Building(building_ID),room_name TEXT NOT NULL,floor_plan_data TEXT,plan_width REAL,plan_height REAL);\\nCREATE TABLE IF NOT EXISTS Controllers(controllers_ID INTEGER PRIMARY KEY AUTOINCREMENT,room_ID INTEGER NOT NULL REFERENCES Room(room_ID),controllers_name TEXT NOT NULL,mac_address TEXT,ip_address TEXT,status TEXT DEFAULT 'offline',wifi INTEGER,last_seen DATETIME);\\nCREATE TABLE IF NOT EXISTS Sensors(sensor_ID INTEGER PRIMARY KEY AUTOINCREMENT,controller_ID INTEGER NOT NULL REFERENCES Controllers(controllers_ID),sensor_type TEXT NOT NULL,gpio_pin INTEGER,pos_x REAL,pos_y REAL);\\nCREATE TABLE IF NOT EXISTS Sensor_Readings(readings_ID INTEGER PRIMARY KEY AUTOINCREMENT,sensor_ID INTEGER NOT NULL REFERENCES Sensors(sensor_ID),temperature REAL,humidity REAL,occupied INTEGER,recorded_at DATETIME DEFAULT CURRENT_TIMESTAMP);\\nCREATE TABLE IF NOT EXISTS Detection(detection_ID INTEGER PRIMARY KEY AUTOINCREMENT,reading_ID INTEGER REFERENCES Sensor_Readings(readings_ID),room_ID INTEGER NOT NULL REFERENCES Room(room_ID),detection_type TEXT,detection_result TEXT,detected_at DATETIME DEFAULT CURRENT_TIMESTAMP);\\nCREATE TABLE IF NOT EXISTS Appliances(appliances_ID INTEGER PRIMARY KEY AUTOINCREMENT,room_ID INTEGER NOT NULL REFERENCES Room(room_ID),controllers_ID INTEGER REFERENCES Controllers(controllers_ID),appliances_name TEXT NOT NULL,appliances_type TEXT,gpio_pin INTEGER,pos_x REAL,pos_y REAL);\\nCREATE TABLE IF NOT EXISTS Appliance_States(states_ID INTEGER PRIMARY KEY AUTOINCREMENT,appliances_ID INTEGER NOT NULL UNIQUE REFERENCES Appliances(appliances_ID),reported_state TEXT DEFAULT 'OFF',desired_state TEXT DEFAULT 'OFF',in_sync INTEGER DEFAULT 1,updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);\\nCREATE TABLE IF NOT EXISTS IR_Command_Codes(code_ID INTEGER PRIMARY KEY AUTOINCREMENT,appliances_ID INTEGER NOT NULL REFERENCES Appliances(appliances_ID),action TEXT,protocol TEXT,raw_code TEXT);\\nCREATE TABLE IF NOT EXISTS Automation_Rules(rules_ID INTEGER PRIMARY KEY AUTOINCREMENT,room_ID INTEGER NOT NULL REFERENCES Room(room_ID),appliances_ID INTEGER NOT NULL REFERENCES Appliances(appliances_ID),trigger_type TEXT NOT NULL,threshold REAL,duration_minutes INTEGER DEFAULT 0,action TEXT NOT NULL,target_value REAL,is_active INTEGER DEFAULT 1);\\nCREATE TABLE IF NOT EXISTS Users(users_ID INTEGER PRIMARY KEY AUTOINCREMENT,users_name TEXT NOT NULL,users_email TEXT NOT NULL UNIQUE,users_password_hash TEXT NOT NULL,role TEXT NOT NULL DEFAULT 'administrator' CHECK(role IN ('administrator')),created_at DATETIME DEFAULT CURRENT_TIMESTAMP);\\nCREATE TABLE IF NOT EXISTS User_Room_Access(users_ID INTEGER NOT NULL REFERENCES Users(users_ID),room_ID INTEGER NOT NULL REFERENCES Room(room_ID),PRIMARY KEY(users_ID,room_ID));\\nCREATE TABLE IF NOT EXISTS Login_History(login_history_ID INTEGER PRIMARY KEY AUTOINCREMENT,user_ID INTEGER REFERENCES Users(users_ID),login_time DATETIME DEFAULT CURRENT_TIMESTAMP,login_status TEXT,ip_address TEXT);\\nCREATE TABLE IF NOT EXISTS Commands(command_ID INTEGER PRIMARY KEY AUTOINCREMENT,appliances_ID INTEGER NOT NULL REFERENCES Appliances(appliances_ID),user_ID INTEGER REFERENCES Users(users_ID),rule_ID INTEGER REFERENCES Automation_Rules(rules_ID),source TEXT,action TEXT,status TEXT,sent_at DATETIME,confirmed_at DATETIME,response_ms INTEGER);\\nCREATE TABLE IF NOT EXISTS Notifications(notification_ID INTEGER PRIMARY KEY AUTOINCREMENT,user_ID INTEGER REFERENCES Users(users_ID),room_ID INTEGER REFERENCES Room(room_ID),detection_ID INTEGER REFERENCES Detection(detection_ID),command_ID INTEGER REFERENCES Commands(command_ID),notification_message TEXT,notification_level TEXT DEFAULT 'info',notification_is_read INTEGER DEFAULT 0,notification_sent_at DATETIME,delivered_at DATETIME);\\nCREATE INDEX IF NOT EXISTS idx_readings_sensor_time ON Sensor_Readings(sensor_ID,recorded_at);\\nCREATE INDEX IF NOT EXISTS idx_notif_user_time ON Notifications(user_ID,notification_sent_at);\\n\";msg.payload=[];return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 155,
