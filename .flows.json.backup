ture'];\nif(!col)return fail(400,'metric must be temperature, humidity or occupancy');\nconst hours=Math.min(168,Math.max(1,parseInt(qs.hours)||12));\nconst fmt=hours>6?'%Y-%m-%dT%H:00:00Z':'%Y-%m-%dT%H:%M:00Z';\nconst w=[`sr.${col} IS NOT NULL`,`sr.recorded_at>=datetime('now','-${hours} hours')`];\nif(qs.room_id)w.push(`c.room_ID=${N(qs.room_id)}`);\nif(qs.building_id)w.push(`c.room_ID IN (SELECT room_ID FROM Room WHERE building_ID=${N(qs.building_id)})`);\nmsg.meta={metric:qs.metric||'temperature',hours,unit:{temperature:'°C',humidity:'%',occupied:'ratio'}[col]};\nsql(`SELECT strftime('${fmt}',sr.recorded_at) t,ROUND(AVG(sr.${col}),2) value FROM Sensor_Readings sr JOIN Sensors s ON s.sensor_ID=sr.sensor_ID JOIN Controllers c ON c.controllers_ID=s.controller_ID WHERE ${w.join(' AND ')} GROUP BY t ORDER BY t`);return [msg,null];",
