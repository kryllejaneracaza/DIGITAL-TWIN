    {
        "id": "eb0007",
        "type": "function",
        "z": "eb_tab",
        "name": "Is Empty?",
        "func": "const n=((msg.payload||[])[0]||{}).n;\nif(n>0){node.status({fill:'grey',shape:'ring',text:'already seeded'});return null;}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 950,
        "y": 155,
        "wires": [
            [
                "eb0008"
            ]
        ]
    },
    {
        "id": "eb0008",
        "type": "function",
        "z": "eb_tab",
        "name": "Seed Data",
        "func": "const ts=d=>d.toISOString().slice(0,19).replace('T',' ');\nconst salt=crypto.randomBytes(8).toString('hex');\nconst hash=salt+':'+crypto.createHash('sha256').update(salt+'admin123').digest('hex');\nconst now=Date.now(),S=[];\nconst campus='Don Bosco Technical College-Cebu';\n[[1,'Main Building'],[2,'MECH LAB'],[3,'COMP LAB']].forEach(b=>S.push(`INSERT OR IGNORE INTO Building(building_ID,building_name,location) VALUES(${b[0]},'${b[1]}','${campus}');`));\nconst rooms=[[1,1,'Room 101','1st Floor'],[2,1,'Room 102','1st Floor'],[3,1,'Room 103','1st Floor'],[4,2,'Mech Room 1','1st Floor'],[5,2,'Mech Room 2','2nd Floor'],[6,3,'Comp Room 1','1st Floor'],[7,3,'Comp Room 2','2nd Floor']];\nlet ap=0;const apMap={};\nrooms.forEach(([id,b,name,floor])=>{\n S.push(`INSERT OR IGNORE INTO Room(room_ID,building_ID,room_name,floor_plan_data,plan_width,plan_height) VALUES(${id},${b},'${name}','${JSON.stringify({floor})}',8,6);`);\n S.push(`INSERT OR IGNORE INTO Controllers(controllers_ID,room_ID,controllers_name,mac_address,ip_address,status,wifi,last_seen) VALUES(${id},${id},'ESP32-R${id}','AA:BB:CC:00:00:0${id}','192.168.1.${100+id}','online',-55,datetime('now'));`);\n S.push(`INSERT OR IGNORE INTO Sensors(sensor_ID,controller_ID,sensor_type,gpio_pin,pos_x,pos_y) VALUES(${2*id-1},${id},'DHT22',4,0.5,0.5),(${2*id},${id},'PIR',5,4,0.3);`);\n const list=[['Smart Light','light',26,2,2,id<=3?'ON':'OFF'],['Air Conditioner','air_conditioner',27,6,0.5,id===1?'ON':'OFF']];\n if(id===1||id>=6)list.push(['Fan','fan',25,4,4,'OFF']);\n apMap[id]={};\n list.forEach(a=>{ap++;apMap[id][a[1]]=ap;\n  S.push(`INSERT OR IGNORE INTO Appliances(appliances_ID,room_ID,controllers_ID,appliances_name,appliances_type,gpio_pin,pos_x,pos_y) VALUES(${ap},${id},${id},'${a[0]}','${a[1]}',${a[2]},${a[3]},${a[4]});`);\n  S.push(`INSERT OR IGNORE INTO Appliance_States(appliances_ID,reported_state,desired_state,in_sync,updated_at) VALUES(${ap},'${a[5]}','${a[5]}',1,datetime('now'));`);\n  if(a[1]==='air_conditioner')S.push(`INSERT OR IGNORE INTO IR_Command_Codes(appliances_ID,action,protocol,raw_code) VALUES(${ap},'ON','NEC','0x20DF10EF'),(${ap},'OFF','NEC','0x20DF906F');`);\n });\n const dht=[],pir=[];\n for(let i=24;i>=0;i--){const t=ts(new Date(now-i*1800000));\n  dht.push(`(${2*id-1},${(27+2*Math.sin(i/4+id)+Math.random()*0.6).toFixed(1)},${(60+4*Math.cos(i/5)+Math.random()).toFixed(1)},NULL,'${t}')`);\n  pir.push(`(${2*id},NULL,NULL,${(i%6<3)?1:0},'${t}')`);}\n S.push(`INSERT INTO Sensor_Readings(sensor_ID,temperature,humidity,occupied,recorded_at) VALUES ${dht.join(',')};`);\n S.push(`INSERT INTO Sensor_Readings(sensor_ID,temperature,humidity,occupied,recorded_at) VALUES ${pir.join(',')};`);\n S.push(`INSERT OR IGNORE INTO User_Room_Access(users_ID,room_ID) VALUES(1,${id});`);\n});\nS.push(`INSERT OR IGNORE INTO Automation_Rules(rules_ID,room_ID,appliances_ID,trigger_type,threshold,duration_minutes,action,is_active) VALUES\n(1,1,${apMap[1].light},'vacant_for',NULL,10,'OFF',1),\n(2,1,${apMap[1].air_conditioner},'temperature_above',28,0,'ON',1),\n(3,1,${apMap[1].air_conditioner},'temperature_below',24,0,'OFF',1),\n(4,2,${apMap[2].air_conditioner},'temperature_above',28,0,'ON',1);`);\nS.push(`INSERT INTO Notifications(user_ID,room_ID,notification_message,notification_level,notification_sent_at,delivered_at) VALUES\n(1,1,'Room 101 is now occupied','info',datetime('now','-2 minutes'),datetime('now','-2 minutes')),\n(1,2,'High temperature: Room 102 is 31.2°C','warning',datetime('now','-5 minutes'),datetime('now','-5 minutes')),\n(1,3,'Sensor offline: Room 103','critical',datetime('now','-8 minutes'),datetime('now','-8 minutes'));`);\nS.push(`INSERT OR IGNORE INTO Users(users_ID,users_name,users_email,users_password_hash,role) VALUES(1,'Leachim Dela Cerna','leachim@gmail.com','${hash}','administrator');`);\nmsg.topic=S.join('\\n');msg.payload=[];return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "crypto",
                "module": "crypto"
            }
        ],
        "x": 1090,
        "y": 155,
        "wires": [
