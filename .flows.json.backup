    {
        "id": "eco0006",
        "type": "function",
        "z": "ecotab1",
        "d": true,
        "name": "auth.signup",
        "func": "const eco = global.get('eco');\n\nif (!eco || typeof eco.handle !== 'function') {\n    msg.statusCode = 500;\n    msg.payload = { success: false, message: \"Backend not initialised\" };\n    return msg;\n}\n\ntry {\n    const out = eco.handle('auth.signup', msg);\n    if (out && typeof out.then === 'function') {\n        return out.then(r => r || null).catch(err => {\n            node.warn(\"auth.signup failed: \" + err.message);\n            msg.statusCode = 500;\n            msg.payload = { success: false, message: \"Signup failed\" };\n            return msg;\n        });\n    }\n    return out || null;\n} catch (err) {\n    node.warn(\"auth.signup failed: \" + err.message);\n    msg.statusCode = 500;\n    msg.payload = { success: false, message: \"Signup failed\" };\n    return msg;\n}",
