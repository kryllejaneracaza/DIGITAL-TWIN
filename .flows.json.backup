        "d": true,
        "name": "auth.logout",
        "func": "const eco = global.get('eco');\n\nif (!eco || typeof eco.handle !== 'function') {\n    msg.statusCode = 500;\n    msg.payload = { success: false, message: \"Backend not initialised\" };\n    return msg;\n}\n\ntry {\n    const out = eco.handle('auth.logout', msg);\n    if (out && typeof out.then === 'function') {\n        return out.then(r => r || null).catch(err => {\n            node.warn(\"auth.logout failed: \" + err.message);\n            msg.statusCode = 500;\n            msg.payload = { success: false, message: \"Logout failed\" };\n            return msg;\n        });\n    }\n    return out || null;\n} catch (err) {\n    node.warn(\"auth.logout failed: \" + err.message);\n    msg.statusCode = 500;\n    msg.payload = { success: false, message: \"Logout failed\" };\n    return msg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
